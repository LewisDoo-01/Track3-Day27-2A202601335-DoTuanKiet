# Sao chép file này thành .env rồi điền giá trị.  (.env đã được .gitignore)

# --- LLM ---------------------------------------------------------------
# "fake"       -> deterministic, không cần mạng (mặc định, dùng cho test)
# "openrouter" -> gọi model thật
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ngưỡng định tuyến HITL (bỏ trống = dùng mặc định trong config.py) --
# HITL_CONFIDENCE_THRESHOLD=0.70
# HITL_RETRIEVAL_THRESHOLD=0.12
# HITL_REVIEW_SLA_SECONDS=900
# HITL_MINUTES_PER_MANUAL_ANSWER=4.0
