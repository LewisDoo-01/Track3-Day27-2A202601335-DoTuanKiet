# Streamlit Cloud: dán nội dung này vào  App → Settings → Secrets  (rồi điền key).
# Local: đổi tên thành secrets.toml (đã được .gitignore).

LLM_PROVIDER = "openrouter"
OPENROUTER_API_KEY = "sk-or-v1-..."
OPENROUTER_MODEL = "google/gemini-2.5-flash"

# Tuỳ chọn — chỉnh ngưỡng định tuyến:
# HITL_CONFIDENCE_THRESHOLD = "0.60"
# HITL_REVIEW_SLA_SECONDS = "900"
